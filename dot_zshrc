# =============================================
# Oh My Zsh (只用插件，主题交给 starship)
# =============================================
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

# =============================================
# 语言 & 编码
# =============================================
export LANG="en_US.UTF-8"
export LANGUAGE="en_US:en"
export LC_ALL="en_US.UTF-8"

# =============================================
# PATH
# =============================================
export PATH="$HOME/.local/bin:$HOME/.pixi/bin:$HOME/data_HD/bin:$PATH"

# =============================================
# Homebrew (Linuxbrew)
# =============================================
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"

# =============================================
# Conda
# =============================================
__conda_setup="$("$HOME/miniconda3/bin/conda" 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
elif [ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]; then
    . "$HOME/miniconda3/etc/profile.d/conda.sh"
else
    [ -d "$HOME/miniconda3/bin" ] && export PATH="$HOME/miniconda3/bin:$PATH"
fi
unset __conda_setup
# 若不希望每次自动激活 base，注释掉下一行
conda activate base

# =============================================
# NVM
# =============================================
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# =============================================
# uv / env
# =============================================
[ -f "$HOME/.local/bin/env" ] && source "$HOME/.local/bin/env"

# =============================================
# 历史记录
# =============================================
setopt APPEND_HISTORY
setopt HIST_IGNORE_SPACE
setopt HIST_IGNORE_DUPS
HISTSIZE=1000
SAVEHIST=2000

# =============================================
# 颜色
# =============================================
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# =============================================
# 别名
# =============================================
# eza 替代 ls
alias ls='eza --icons'
alias ll='eza -la --icons --git'
alias la='eza -a --icons'
alias l='eza -CF --icons'
alias lt='eza --tree --icons'

alias zshconfig="mate ~/.zshrc"
alias ohmyzsh="mate ~/.oh-my-zsh"
alias cz="codewiz-cc"
alias cl="clear"
alias sz='source ~/.zshrc'
alias cg='chgrp -R'
alias sp="source .venv/bin/activate"
alias tmux-kill="tmux kill-session -t"
alias gitr="git remote set-url origin"
alias hlp='tldr'
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# 加载外部别名
[ -f ~/.bash_aliases ] && source ~/.bash_aliases

# =============================================
# 代理配置
# =============================================
export http_proxy=http://10.140.24.177:3128
export https_proxy=http://10.140.15.68:3128
export HTTP_PROXY=http://10.140.24.177:3128
export HTTPS_PROXY=http://10.140.15.68:3128
export no_proxy=localhost,127.0.0.1,::1
export NO_PROXY=localhost,127.0.0.1,::1

# =============================================
# 其他环境变量
# =============================================
export SHELL=/usr/bin/zsh
export TERMINFO_DIRS="/usr/share/terminfo:/lib/terminfo"
export TLDR_LANGUAGE="zh"

# =============================================
# 外部工具集成
# =============================================
# thefuck
if command -v thefuck &> /dev/null; then
    eval $(thefuck --alias)
fi

# lesspipe
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# starship / zoxide / fzf
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# =============================================
# 工具函数
# =============================================
# Hugging Face 镜像下载
hfd() {
    wget https://hf-mirror.com/hfd/hfd.sh && \
    chmod a+x hfd.sh && \
    HF_ENDPOINT=https://hf-mirror.com bash ./hfd.sh "$@"
}

# 重新加载配置
reload() {
    source ~/.zshrc
    echo "配置已重新加载"
}

# tmux 交互式切换 session
ts() {
    local session
    session=$(tmux ls -F "#{session_name}" 2>/dev/null | fzf --height 40% --reverse)
    [ -n "$session" ] && tmux a -t "$session"
}

# =============================================
# 本地私密配置（不入库）
# 在 ~/.zshrc.local 中设置 ANTHROPIC_API_KEY 等敏感变量
# =============================================
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

reset
